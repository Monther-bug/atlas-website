{
  "name": "atlas-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fonts": "node scripts/subset-fonts.mjs",
    "assets": "node scripts/build-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:production": "BUILD_TARGET=production npm run build",
    "preview": "vite preview --port 4173",
    "qa": "node qa/run-qa.mjs",
    "lighthouse": "node qa/lighthouse.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "og:cranes": "node scripts/build-crane-og.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
